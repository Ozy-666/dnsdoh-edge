# Instance settings for tls-sync.sh, one file per dnsdist instance, kept outside the repo as
# /etc/dnsdoh.art/tls-sync-<instance>.env (dnsdist-tls.service reads tls-sync-prod.env), root-owned
# 0644: tls-sync.sh sources it as root. These values match the published units.
SRC=/etc/letsencrypt/live/unified.dnsdoh.art  # certbot live dir holding fullchain.pem and privkey.pem;
                                              # dnsdist-tls.path watches the same lineage's archive/ dir
DST=/etc/dnsdist/tls                          # where dnsdist reads its copy (root:dnsdist 0640)
UNIT=dnsdist                                  # systemd unit of the instance
BIN=/opt/dnsdist/prod/bin/dnsdist             # the binary dnsdist.service runs, used as the console client
CC=/etc/dnsdist/console-client.lua            # console client config (controlSocket + key)
NGX=                                          # unit to reload as well if it reads SRC itself; empty = none
SNI=dnsdoh.art                                # server name the verify step asks for
VERIFY_ADDRS="192.0.2.1:853"                  # space-separated host:port list that must serve the new serial
                                              # (here site-example.lua's DoT listener)
